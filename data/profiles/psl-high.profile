id=psl-high
label=PSlibrary 1.0.0 (high accuracy)
families=paw us nc
provenance=native
generator=ld1
set_paw=paw-high
set_us=us-high
set_nc=nc
upstream=pslibrary.1.0.0
author=Andrea Dal Corso
reference=https://dalcorso.github.io/pslibrary/
license=GPL-2.0-or-later
summary=The reference PSlibrary set: most semicore states, smallest cut-off radii, highest transferability. Needs a high kinetic-energy cutoff.
notes=Recipes are byte-identical to the upstream .job files except where data/psl/ERRATA.tsv declares a correction (two decks, both caesium -- see docs/PROVENANCE.md); verified by tests/test_psl_roundtrip.sh, which fails on any undeclared difference. The nc family comes from nc_ps_collection.job, which upstream labels experimental and untested.
engine=ld1
available=pz, pw, vwn, pbe, pbesol, pw91, bp, blyp, revpbe, wc -- scalar and fully-relativistic. 97 elements PAW and US, 92 NC. Shipped in full.
xc_available=pz pw vwn pbe pbesol pw91 bp blyp revpbe wc
rel_available=scalar full
families_note=PAW and US for 97 elements, NC for 92
formats=upf xml
