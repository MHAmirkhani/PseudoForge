id=sg15
label=SG15 ONCV (Schlipf-Gygi)
families=nc
provenance=reproducible
generator=oncvpsp
upstream=SG15 ONCV potentials
author=M. Schlipf, F. Gygi
reference=http://www.quantum-simulation.org/potentials/sg15_oncv/
license=CC-BY-SA-4.0
summary=Optimised norm-conserving Vanderbilt (ONCV) pseudopotentials, multiple projectors per channel, accurate and reasonably soft for norm-conserving.
notes=ONCVPSP output. Schlipf and Gygi publish their generation decks in the source tarball (elements/<NN>_<El>/*.dat, 86 of them), so PseudoForge ships those and runs them with the ONCVPSP build it makes -- a real reproduction, recorded with provenance 'library'. They are bundled, so generation works offline; 'params fetch sg15' only refreshes them.
default_ecutwfc=60
default_ecutrho=240
engine=oncvpsp
available=PBE only (no PBEsol, no LDA). 69 elements scalar-relativistic; fully-relativistic files exist for 52. Bundled: 86 ONCVPSP decks.
xc_available=pbe
rel_available=scalar full
families_note=NC only; 69 elements scalar, 52 fully-relativistic
formats=upf psp8 xml
